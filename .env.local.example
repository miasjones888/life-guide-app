# ── AI Provider ────────────────────────────────────────────────────
# Which AI provider to use. Options: "auto" | "openai" | "anthropic"
# "auto" tries OpenAI first, then Anthropic as fallback.
AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Google Calendar & Gmail ─────────────────────────────────────────
# Required for live calendar data in the assistant + calendar action execution.
# See docs/google-oauth-setup.md for step-by-step instructions.

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generated via OAuth2 Playground (see setup guide)
# Scopes needed: https://www.googleapis.com/auth/calendar + https://mail.google.com/
GOOGLE_REFRESH_TOKEN=
