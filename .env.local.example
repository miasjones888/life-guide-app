# ── AI Provider ────────────────────────────────────────────────────
# Which AI provider to use. Options: "auto" | "openai" | "anthropic"
# "auto" tries OpenAI first, then Anthropic as fallback.
AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Google Calendar & Gmail ─────────────────────────────────────────
# Required for live calendar data in the assistant + calendar action execution.
# See docs/google-oauth-setup.md for step-by-step instructions.

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generated via OAuth2 Playground (see setup guide)
# Scopes needed: https://www.googleapis.com/auth/calendar + https://mail.google.com/
GOOGLE_REFRESH_TOKEN=

# ── Write API protection ────────────────────────────────────────────
# Optional. If set, the /api/calendar and /api/email endpoints require this
# value as the x-write-secret request header. Protects calendar/email writes
# in public deployments. Generate any random string (e.g. openssl rand -hex 32).
# Must use NEXT_PUBLIC_ prefix so the browser client can read it.
NEXT_PUBLIC_WRITE_SECRET=
